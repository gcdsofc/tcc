{
  "name": "garageops-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Microsserviços GarageOps (identidade, clientes/veículos e ordens) em NestJS + TypeScript",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:identity": "node dist/apps/identity/src/main.js",
    "start:customers": "node dist/apps/customers/src/main.js",
    "start:workorders": "node dist/apps/workorders/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
