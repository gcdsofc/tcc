{
  "name": "oficinapro-mvp",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @oficinapro/web",
    "build": "npm run build -w @oficinapro/web && npm --prefix backend run build",
    "test": "npm --prefix backend test",
    "test:cov": "npm --prefix backend run test:cov",
